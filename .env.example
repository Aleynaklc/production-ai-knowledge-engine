# Application settings. Copy this file to .env for local overrides.
PAKE_APP_NAME="Production AI Knowledge Engine"
PAKE_ENVIRONMENT="development"
PAKE_LOG_LEVEL="INFO"

# Local Hugging Face inference
PAKE_MODEL_NAME="Qwen/Qwen2.5-0.5B-Instruct"
PAKE_MODEL_REVISION="c89bee90d9f811437d9735454613c35b4a3c4dc8"
PAKE_DEVICE="auto"
PAKE_MAX_NEW_TOKENS=128

# Ingestion and retrieval
PAKE_CHUNK_STRATEGY="recursive"
PAKE_CHUNK_SIZE_TOKENS=160
PAKE_CHUNK_OVERLAP_TOKENS=30
PAKE_EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
PAKE_EMBEDDING_MODEL_REVISION="1110a243fdf4706b3f48f1d95db1a4f5529b4d41"
PAKE_RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L6-v2"
PAKE_RERANKER_MODEL_REVISION="233902d25c440f23af6f7d6e94d2946bac0bee0a"
PAKE_RETRIEVAL_DEVICE="auto"
PAKE_QDRANT_PATH="data/qdrant"
PAKE_QDRANT_COLLECTION="novastack_chunks"
PAKE_RETRIEVAL_TOP_K=5
PAKE_RETRIEVAL_CANDIDATE_K=20
PAKE_RAG_TOP_K=5
PAKE_RAG_MAX_SOURCES=3
PAKE_RAG_CONTEXT_TOKENS=650
PAKE_RAG_MAX_NEW_TOKENS=80
PAKE_RAG_STRICT_GROUNDING=true
PAKE_RAG_MIN_RETRIEVAL_SCORE=0.8
PAKE_RAG_EXTRACTIVE_FALLBACK_SCORE=1.0
