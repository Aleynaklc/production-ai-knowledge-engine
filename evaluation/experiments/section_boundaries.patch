+def test_new_headings_never_copy_facts_from_the_previous_section() -> None:
+    text = "# Guide\n## Cedar\nCedar costs 17 credits.\n## Birch\nBirch costs 29 credits."
+    chunks = RecursiveChunker(WordCodec(), 100, 10).chunk(text)
+    assert len(chunks) == 2
+    assert "17" in chunks[0] and "29" not in chunks[0]
+    assert "29" in chunks[1] and "17" not in chunks[1]
+    assert "## Birch" in chunks[1]
+
+
+def test_markdown_like_comments_inside_code_do_not_start_sections() -> None:
+    code = "```python\n# First comment\nx = 1\n# Second comment\ny = 2\n```"
+    text = "## Example\n" + code + "\n## Notes\nDo not execute unknown code."
+    chunks = RecursiveChunker(WordCodec(), 100, 10).chunk(text)
+    assert len(chunks) == 2 and code in chunks[0]
+    assert "unknown" not in chunks[0]
